# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables  (copy to backend/.env and fill in real values)
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Supabase PostgreSQL — session-pooler URL (used by the app at runtime)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true

# Supabase PostgreSQL — direct URL (used ONLY by prisma migrate)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase project settings (for JWT verification in routes)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # Service role key — never expose to frontend
SUPABASE_JWT_SECRET=your-jwt-secret # Found in Supabase Dashboard → Project Settings → API

# Express server
PORT=4000
API_HOST=0.0.0.0

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,https://<vercel-frontend-domain>

# Session (custom auth — keep for compatibility with auth module)
APP_BASE_URL=http://localhost:5173
SESSION_SECRET=<48-byte-hex>
PASSWORD_PEPPER=<48-byte-hex>
SESSION_TTL_MINUTES=480
SESSION_ABSOLUTE_TTL_MINUTES=1440

# Rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
GLOBAL_RATE_LIMIT_MAX=600

# Uploads
MAX_UPLOAD_BYTES=10485760
MAX_IMPORT_ROWS=20000

# Misc
ALLOW_DEMO_SEED=false
TRUST_PROXY=1

# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment variables  (copy to frontend/.env)
# ─────────────────────────────────────────────────────────────────────────────
# VITE_API_BASE_URL=http://localhost:4000
# (prod) VITE_API_BASE_URL=https://<backend-vercel-domain>
