    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "exceljs": "^4.4.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "@types/pdfkit": "^0.13.5",
    "@types/uuid": "^10.0.0",
